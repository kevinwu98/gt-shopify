# Copy to .env.locadex (ignored by Git). Do not put provider keys in .env.example.
# Internal Locadex core checkout with its workspace dependencies installed:
LOCADEX_CORE_DIR=/absolute/path/to/gt-cloud/packages/locadex-core
LOCADEX_AGENT=openai
OPENAI_API_KEY=
# For Anthropic instead: LOCADEX_AGENT=anthropic and ANTHROPIC_API_KEY=...
